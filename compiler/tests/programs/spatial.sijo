// Spatial acceleration must not change results: several archetypes in one query, break, continue,
// conjunctions in the guard, an early `if (far) continue;`, float accumulation order. Built with and
// without -DSIJO_NO_SPATIAL.
public struct SVec2
{
    public float X;
    public float Y;

    public float LengthSq => X * X + Y * Y;

    public SVec2(float x, float y)
    {
        X = x;
        Y = y;
    }

    public static SVec2 operator -(SVec2 a, SVec2 b) => new SVec2(a.X - b.X, a.Y - b.Y);
    public static SVec2 operator +(SVec2 a, SVec2 b) => new SVec2(a.X + b.X, a.Y + b.Y);
    public static SVec2 operator *(SVec2 a, float s) => new SVec2(a.X * s, a.Y * s);
}

public class Mote : Entity
{
    public mut SVec2 Pos;
    public mut SVec2 Vel;
    public mut float Heat;
    public mut int Touches;

    public void Update(float dt)
    {
        mut float sum = 0;
        mut int seen = 0;
        foreach (var o in Query<Mote>())
        {
            if (o == this)
            {
                continue;
            }
            float dx = o.Pos.X - Pos.X;
            float dy = o.Pos.Y - Pos.Y;
            if (dx * dx + dy * dy < 25 && o.Heat >= 0)
            {
                sum += o.Heat * 0.37 + dx;
                seen++;
                if (seen > 30)
                {
                    break;
                }
            }
        }
        Heat = Heat * 0.9 + sum * 0.01;
        Touches += seen;
        Pos = Pos + Vel * 1;
        if (Pos.X < 0 || Pos.X > 300)
        {
            Vel = new SVec2(-Vel.X, Vel.Y);
        }
        if (Pos.Y < 0 || Pos.Y > 300)
        {
            Vel = new SVec2(Vel.X, -Vel.Y);
        }
    }
}

public class HotMote : Mote
{
    public int Flag;
}

public class Probe : Entity
{
    public SVec2 Pos;
    public mut float Total;

    public void Update(float dt)
    {
        foreach (var m in Query<Mote>())
        {
            if ((m.Pos - Pos).LengthSq <= 100)
            {
                Total += m.Heat;
            }
        }
    }
}

// early-out form: `if (far) continue;` before the work (also accelerated)
public class Spark : Entity
{
    public mut SVec2 Pos;
    public mut float Glow;
    public mut int Near;

    public void Update(float dt)
    {
        foreach (var m in Query<Mote>())
        {
            SVec2 d = m.Pos - Pos;
            if (d.LengthSq >= 64 || m.Heat < 0)
            {
                continue;
            }
            Glow += m.Heat * 0.5 + d.X;
            Near++;
        }
        Pos = Pos + new SVec2(0.5, 0.25);
    }
}

public static class Game
{
    public static void Start()
    {
        for (int i = 0; i < 1500; i++)
        {
            SVec2 p = new SVec2(Random.Float(0, 300), Random.Float(0, 300));
            SVec2 v = new SVec2(Random.Float(-1, 1), Random.Float(-1, 1));
            if (i % 3 == 0)
            {
                Spawn(new HotMote { Pos = p, Vel = v, Heat = Random.Float(0, 10) });
            }
            else
            {
                Spawn(new Mote { Pos = p, Vel = v, Heat = Random.Float(-1, 5) });
            }
        }
        for (int i = 0; i < 100; i++)
        {
            Spawn(new Probe { Pos = new SVec2(i * 3, 150) });
            Spawn(new Spark { Pos = new SVec2(i * 3, i * 2.5) });
        }
    }
}
