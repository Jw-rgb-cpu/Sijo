// Multi-dimensional arrays T[,] and T[,,]: new T[w, h], initializers, a[i, j] (every index checked
// against its dimension), Length, Rank, GetLength, GetUpperBound, foreach in row-major order,
// Clone, elements that are structs, strings and lists, T[][,] and T[,][], parameters (borrowed,
// ref, own) and return values, entity fields (constant initializers, replaced, read by other
// entities through the snapshot, replicated to clients, freed when the entity is destroyed) and
// message arguments. Expected output: the same program in C# (.NET 8), except that the elements of
// new int[2][,], new int[2, 2][] and new List<int>[2, 2] start empty in Sijo (null in C#, 11.7).
public struct SCell
{
    public int X;
    public string Name;
}

public static class Grid
{
    public const int W = 3;
    public const int H = 4;

    public static own int[,] Make(int w, int h)
    {
        mut int[,] g = new int[w, h];
        for (int x = 0; x < g.GetLength(0); x++)
        {
            for (int y = 0; y < g.GetLength(1); y++)
            {
                g[x, y] = x * 10 + y;
            }
        }
        return g;
    }

    public static int Sum(int[,] g)
    {
        mut int s = 0;
        foreach (int v in g)
        {
            s += v;
        }
        return s;
    }

    public static string Show(int[,] g)
    {
        mut string s = "";
        for (int x = 0; x < g.GetLength(0); x++)
        {
            s += "[";
            for (int y = 0; y < g.GetLength(1); y++)
            {
                s += (y > 0 ? "," : "") + g[x, y];
            }
            s += "]";
        }
        return s;
    }

    public static void Bump(ref int[,] g)
    {
        for (int x = 0; x <= g.GetUpperBound(0); x++)
        {
            g[x, x] += 100;
        }
    }

    public static int Corner(own int[,] g)
    {
        return g[g.GetLength(0) - 1, g.GetLength(1) - 1];
    }
}

public class Board : Entity
{
    public mut int[,] Cells = new int[Grid.W, Grid.H];
    public mut float[,,] Cube = new float[2, 2, 2];
    public string[,] Names = { { "ann", "bob" }, { "cy", "dee" } };
    public int Id;
    public mut int Seen;
    public mut int Stamped;

    public void Update(float dt)
    {
        int t = Time.Tick;
        Cells[t % Cells.GetLength(0), (t + Id) % Cells.GetLength(1)] += Id + 1;
        Cube[t % 2, Id % 2, 1] += 0.5;
        // other boards' cells: the start-of-system snapshot
        mut int seen = 0;
        foreach (var b in Query<Board>())
        {
            if (b != this)
            {
                seen += Grid.Sum(b.Cells);
            }
        }
        Seen = seen;
        if (t == 15)
        {
            Cells = new int[2, 2];
        }
    }

    // a message: the receiver gets its own copy of the array
    public void Stamp(int[,] pattern)
    {
        for (int x = 0; x < pattern.GetLength(0); x++)
        {
            for (int y = 0; y < pattern.GetLength(1); y++)
            {
                Stamped += pattern[x, y];
            }
        }
    }

    public client void Render()
    {
        Draw.Text(Cells.GetLength(0), Cells.GetLength(1), $"{Grid.Sum(Cells)} {Names[1, 0]}");
    }
}

public class Spark : Entity
{
    public mut int[,] Heat = new int[4, 4];
    public mut List<int>[,] Bins = new List<int>[2, 2];
    public int[] Marks = new int[2];
    public int Life;

    public void Update(float dt)
    {
        Heat[Life % 4, 0] += 1;
        Bins[Life % 2, 1].Add(Life);
        if (Time.Tick % 3 == Life % 3)
        {
            Destroy();
        }
    }
}

public static class Game
{
    public static void Start()
    {
        mut int[,] g = Grid.Make(Grid.W, Grid.H);
        Print($"{g.Length} {g.Rank} {g.GetLength(0)} {g.GetLength(1)} {g.GetUpperBound(1)} {g[2, 3]} {Grid.Sum(g)}");
        Print(Grid.Show(g));
        int[,] lit = { { 1, 2, 3 }, { 4, 5, 6 } };
        var lit2 = new int[,] { { 7 }, { 8 } };
        var lit3 = new int[2, 1] { { 9 }, { 10 } };
        Print($"{Grid.Show(lit)} {lit.GetLength(0)}x{lit.GetLength(1)} {Grid.Show(lit2)} {Grid.Show(lit3)}");
        mut int[,] c = g.Clone();
        c[0, 0] = 99;
        g[1, 1]++;
        g[2, 2] *= 2;
        Grid.Bump(ref g);
        Print($"{g[0, 0]} {c[0, 0]} {g[1, 1]} {g[2, 2]} {c.GetLength(0)}x{c.GetLength(1)} {Grid.Corner(c)}");
        mut SCell[,] cells = new SCell[2, 2];
        cells[1, 0].X = 5;
        cells[0, 1] = new SCell { X = 7, Name = "seven" };
        Print($"{cells[1, 0].X} {cells[0, 1].Name} [{cells[0, 0].Name}] {cells[1, 1].X}");
        mut int[,,] cube = new int[2, 3, 4];
        mut int k = 0;
        for (int a = 0; a < 2; a++)
        {
            for (int b = 0; b < 3; b++)
            {
                for (int d = 0; d < 4; d++)
                {
                    cube[a, b, d] = k;
                    k++;
                }
            }
        }
        mut string order = "";
        foreach (var v in cube)
        {
            order += $"{v} ";
        }
        mut int lens = 0;
        for (int d = 0; d < cube.Rank; d++)
        {
            lens = lens * 10 + cube.GetLength(d);
        }
        Print($"{cube.Length} {cube.Rank} {lens} {cube[1, 2, 3]} {cube[1, 0, 2]} {order.Trim()}");
        string[,] empty = new string[0, 3];
        Print($"empty {empty.Length} {empty.GetLength(0)} {empty.GetLength(1)}");
        mut int[][,] jag = new int[2][,];
        jag[1] = new int[1, 2];
        jag[1][0, 1] = 5;
        mut int[,][] rows = new int[2, 2][];
        rows[1, 1] = new int[] { 7, 8 };
        mut List<int>[,] bins = new List<int>[2, 2];
        bins[0, 1].Add(3);
        bins[0, 1].Add(4);
        Print($"{jag[0].Length} {jag[1][0, 1]} {rows[0, 0].Length} {rows[1, 1][1]} {bins[0, 1].Count} {bins[1, 0].Count}");
        for (int i = 0; i < 3; i++)
        {
            Spawn(new Board { Id = i });
        }
    }

    public static void Update(float dt)
    {
        // the arrays given here replace (and free) the ones the initializers made; Marks is never read
        Spawn(new Spark { Life = Time.Tick, Heat = new int[4, 4], Marks = new int[] { Time.Tick } });
        if (Time.Tick % 5 == 0)
        {
            int[,] pattern = { { Time.Tick, 1 }, { 2, 3 } };
            foreach (var b in Query<Board>())
            {
                b.Stamp(pattern);
            }
        }
        if (Time.Tick % 10 == 0)
        {
            foreach (var b in Query<Board>())
            {
                Print($"tick {Time.Tick} board {b.Id}: {Grid.Show(b.Cells)} seen={b.Seen} stamped={b.Stamped} cube={b.Cube[0, 0, 1]:F1},{b.Cube[1, 1, 1]:F1} names={b.Names[1, 0]}");
            }
            mut int heat = 0;
            foreach (var s in Query<Spark>())
            {
                heat += s.Heat[s.Life % 4, 0] + s.Bins[s.Life % 2, 1].Count;
            }
            Print($"sparks {Count<Spark>()} heat {heat}");
        }
    }
}
