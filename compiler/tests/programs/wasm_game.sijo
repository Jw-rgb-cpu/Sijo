public static class Host
{
    public static extern("host_log") void Log(string what, int[] cells);
    [Deferred] public static extern("host_shake") void Shake(int who, float amount);
    public static extern("host_key") bool Key(int code);
}
public class World : Entity
{
    public mut int[8] G;
    public mut int Bad;
    public string Name = "w";
    public void Update(float dt)
    {
        for (int i = 0; i < 8; i++) { G[i] += i; }
        if (Time.Tick % 20 == 0) { Host.Shake(Time.Tick, 0.5f); }
        if (Time.Tick == 50) { int[] xs = new int[2]; Bad = xs[Time.Tick]; }
    }
    public client void Render()
    {
        if (Time.Tick % 25 == 0) { Host.Log($"tick {Time.Tick}", G); }
        if (Host.Key(32)) { Draw.Text(1, 1, "space"); }
        Draw.Sprite(3, 2, 2);
    }
}
public static class Game
{
    public static void Start() { Spawn(new World { }); }
}
