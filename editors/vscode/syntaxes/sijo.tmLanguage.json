{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Sijo",
  "scopeName": "source.sijo",
  "patterns": [
    { "include": "#comments" },
    { "include": "#attributes" },
    { "include": "#strings" },
    { "include": "#ranges" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#builtins" },
    { "include": "#declarations" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.double-slash.sijo", "match": "//.*$" },
        { "name": "comment.block.sijo", "begin": "/\\*", "end": "\\*/" }
      ]
    },
    "attributes": {
      "name": "meta.attribute.sijo",
      "begin": "\\[(?=\\s*(Precision|Replicated|NotReplicated|Spatial|Component|Pure|Recursive)\\b)",
      "end": "\\]",
      "patterns": [
        { "name": "entity.name.function.attribute.sijo", "match": "\\b(Precision|Replicated|NotReplicated|Spatial|Component|Pure|Recursive)\\b" },
        { "include": "#numbers" },
        { "include": "#strings" }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.interpolated.sijo",
          "begin": "\\$\"",
          "end": "\"",
          "patterns": [
            { "name": "constant.character.escape.sijo", "match": "\\\\." },
            { "name": "meta.interpolation.sijo", "begin": "\\{", "end": "\\}", "patterns": [{ "include": "$self" }] }
          ]
        },
        { "name": "string.quoted.double.sijo", "begin": "\"", "end": "\"", "patterns": [{ "name": "constant.character.escape.sijo", "match": "\\\\." }] },
        { "name": "string.quoted.single.sijo", "match": "'(\\\\(u[0-9a-fA-F]{4}|U[0-9a-fA-F]{8}|x[0-9a-fA-F]{1,4}|.)|[^'\\\\])'" }
      ]
    },
    "ranges": {
      "comment": "a range type: int in 0..100, float in -0.5..0.5 (the 'in' of foreach is a keyword.control)",
      "match": "\\b(in)\\s+(-?\\s*[0-9][0-9_]*(?:\\.[0-9_]+)?(?:[eE][+-]?[0-9]+)?[fF]?)\\s*(\\.\\.)\\s*(-?\\s*[0-9][0-9_]*(?:\\.[0-9_]+)?(?:[eE][+-]?[0-9]+)?[fF]?)",
      "captures": {
        "1": { "name": "storage.modifier.range.sijo" },
        "2": { "name": "constant.numeric.sijo" },
        "3": { "name": "keyword.operator.range.sijo" },
        "4": { "name": "constant.numeric.sijo" }
      }
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.hex.sijo", "match": "\\b0[xX][0-9a-fA-F_]+\\b" },
        { "name": "constant.numeric.sijo", "match": "\\b[0-9][0-9_]*(\\.[0-9_]+)?([eE][+-]?[0-9]+)?[fFdD]?\\b" }
      ]
    },
    "keywords": {
      "patterns": [
        { "name": "keyword.control.sijo", "match": "\\b(if|else|while|do|for|foreach|in|return|break|continue|atomic|fail|switch|case|default|when|await)\\b" },
        { "name": "keyword.other.sijo", "match": "\\b(using|namespace|new|this|base|is|ref|out|var|operator|and|or|not|where)\\b" },
        { "name": "storage.modifier.sijo", "match": "\\b(public|private|protected|static|const|virtual|override|abstract|async|extern|client|mut|own)\\b" },
        { "name": "storage.type.sijo", "match": "\\b(class|struct|enum|interface|component)\\b" },
        { "name": "constant.language.sijo", "match": "\\b(true|false|null)\\b" }
      ]
    },
    "types": {
      "patterns": [
        { "name": "storage.type.primitive.sijo", "match": "\\b(int|float|bool|void|string|char)\\b" },
        { "name": "support.type.sijo", "match": "\\b(List|Dictionary|KeyValuePair|Entity)\\b" }
      ]
    },
    "builtins": {
      "patterns": [
        { "name": "support.function.sijo", "match": "\\b(Spawn|Destroy|Print|Query|Count|Wait|NextTick|Until)\\b" },
        { "name": "support.class.sijo", "match": "\\b(Math|Random|Time|Draw|Array)\\b" }
      ]
    },
    "declarations": {
      "patterns": [
        { "match": "\\b(class|struct|enum|interface|component)\\s+([\\p{L}_][\\p{L}\\p{N}_]*)", "captures": { "1": { "name": "storage.type.sijo" }, "2": { "name": "entity.name.type.sijo" } } },
        { "match": "\\b([\\p{L}_][\\p{L}\\p{N}_]*)\\s*(?=\\()", "captures": { "1": { "name": "entity.name.function.sijo" } } }
      ]
    }
  }
}
